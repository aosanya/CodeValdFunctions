#!/usr/bin/env python3
"""
compile-flutter — CodeValdFunctions binary function

Protocol:
  stdin:  JSON { "job_id": "...", "agency_id": "...", "task_id": "...", "payload": "..." }
  stdout: JSON { "status": "ok"|"error"|"issues-found", "result": "...", "error": "..." }
  exit 0: job completes; exit 1: job fails (infrastructure error only)

Environment:
  FN_GIT_CLONE_BASE   base URL for Cross (e.g. http://codevaldcross:8081)
                      git clone uses /{agencyId}/{repoName} (no /git prefix)
                      REST APIs use /git/{agencyId}/... and /work/{agencyId}/...
  FN_DEFAULT_REPO     repository name (e.g. shared-farms)
  FN_CROSS_AUTH_USER  Cross basic-auth username (optional)
  FN_CROSS_AUTH_PASS  Cross basic-auth password (optional)
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
import urllib.error
import base64
from datetime import datetime, timedelta, timezone


IMPORT_RE = re.compile(r"""^\s*import\s+['"]([^'"]+)['"]""", re.MULTILINE)


def fail(msg):
    print(json.dumps({"status": "error", "error": msg}))
    sys.exit(1)


def cross_get(url, auth_header):
    req = urllib.request.Request(url, headers={"Authorization": auth_header} if auth_header else {})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"GET {url} → {e.code}: {e.read().decode()[:200]}")
    except Exception as e:
        raise RuntimeError(f"GET {url} → {e}")


def find_branch(cross_base, agency_id, repo, task_id, task_name, auth_header, branch_name=""):
    """
    Return the best branch name to analyze for this task.
    Priority:
      1. task.branchName (set by the AI via work.task.update after branch creation)
      2. Any branch whose name contains the task code (e.g. UTIL017)
      3. task/{task_id}
      4. main
    """
    # Priority 1: use the task's explicit branch name if available.
    if branch_name and branch_name != "main":
        return branch_name

    try:
        data = cross_get(
            f"{cross_base}/git/{agency_id}/repositories/{repo}/branches",
            auth_header,
        )
        branches = data.get("branches", [])
        names = [b.get("name", "") for b in branches if b.get("name")]

        task_code = (task_name or "").upper()
        if task_code:
            for name in names:
                if task_code in name.upper():
                    return name

        task_branch = f"task/{task_id}"
        if task_branch in names:
            return task_branch

    except Exception as e:
        print(f"compile-flutter: branch lookup failed: {e}", file=sys.stderr)

    return "main"


def check_imports(tree_root):
    """
    Walk every *.dart file under tree_root/lib and verify that each relative
    `import 'path.dart';` resolves to an existing file. `dart:` and `package:`
    URIs are skipped — those are resolved by pub, not the file tree.

    Returns a list of human-readable error strings (one per unresolved import);
    empty list if every relative import resolves.
    """
    issues = []
    lib_dir = os.path.join(tree_root, "lib")
    if not os.path.isdir(lib_dir):
        return issues

    for root, _, files in os.walk(lib_dir):
        for fname in files:
            if not fname.endswith(".dart"):
                continue
            fpath = os.path.join(root, fname)
            try:
                with open(fpath, "r", encoding="utf-8", errors="replace") as f:
                    src = f.read()
            except Exception:
                continue
            for uri in IMPORT_RE.findall(src):
                if uri.startswith("dart:") or uri.startswith("package:"):
                    continue
                target = os.path.normpath(os.path.join(os.path.dirname(fpath), uri))
                if not os.path.isfile(target):
                    rel_src = os.path.relpath(fpath, tree_root)
                    rel_target = os.path.relpath(target, tree_root)
                    issues.append(
                        f"{rel_src}: uri_does_not_exist: '{uri}' "
                        f"(resolved to {rel_target})"
                    )
    return issues


def pubsub_expected_paths(cross_base, agency_id, branch, after_iso, auth_header):
    """
    Query CodeValdPubSub for git.file.written events on `branch` since
    `after_iso` (RFC3339) and return the set of paths CodeValdGit reports as
    written. Defensive check for BUG-09-020 Phase 3: even with Phase 1's
    per-agency lock and Phase 2's dispatcher gate, a clone that disagrees
    with the event log is treated as an infrastructure error rather than a
    code issue.

    Returns the set of paths; an empty set on any query/parse failure (the
    caller treats that as "no defensive check available" and proceeds).
    """
    query = urllib.parse.urlencode({
        "topic":           "git.file.written",
        "after_timestamp": after_iso or "",
        "limit":           "500",
    })
    url = f"{cross_base}/pubsub/{agency_id}/events?{query}"
    try:
        data = cross_get(url, auth_header)
    except Exception as e:
        print(f"compile-flutter: pubsub query failed, skipping defensive check: {e}", file=sys.stderr)
        return set()

    paths = set()
    for ev in data.get("events", []):
        raw = ev.get("payload", "")
        if not raw:
            continue
        try:
            payload = json.loads(raw)
        except Exception:
            continue
        if payload.get("branch_name") != branch:
            continue
        path = payload.get("path", "")
        if path:
            paths.add(path)
    return paths


def missing_from_tree(tmpdir, paths):
    """Return the subset of `paths` that are not present as files under tmpdir."""
    missing = []
    for path in paths:
        if not os.path.isfile(os.path.join(tmpdir, path)):
            missing.append(path)
    return missing


def main():
    try:
        inp = json.load(sys.stdin)
    except Exception as e:
        fail(f"parse stdin: {e}")

    task_id   = inp.get("task_id", "")
    agency_id = inp.get("agency_id", "")
    job_id    = inp.get("job_id", "")

    if not task_id:
        fail("task_id missing from input")

    cross_base = os.environ.get("FN_GIT_CLONE_BASE", "").rstrip("/")
    repo       = os.environ.get("FN_DEFAULT_REPO", "")
    if not cross_base or not repo:
        fail("FN_GIT_CLONE_BASE or FN_DEFAULT_REPO not set")

    auth_user = os.environ.get("FN_CROSS_AUTH_USER", "")
    auth_pass = os.environ.get("FN_CROSS_AUTH_PASS", "")
    auth_header = ""
    if auth_user and auth_pass:
        creds = base64.b64encode(f"{auth_user}:{auth_pass}".encode()).decode()
        auth_header = f"Basic {creds}"

    # Fetch task name and branch name for branch lookup
    task_name = ""
    task_branch_name = ""
    task_obj = {}
    try:
        task_data = cross_get(
            f"{cross_base}/work/{agency_id}/tasks/{task_id}",
            auth_header,
        )
        task_obj = task_data.get("task", task_data)
        task_name = task_obj.get("taskName", "")
        task_branch_name = task_obj.get("branchName", "")
    except Exception as e:
        print(f"compile-flutter: task lookup failed: {e}", file=sys.stderr)

    branch = find_branch(cross_base, agency_id, repo, task_id, task_name, auth_header, task_branch_name)

    # git clone uses the smart-HTTP route: /{agencyId}/{repoName} (no /git prefix)
    clone_url = f"{cross_base}/{agency_id}/{repo}"

    print(
        f"compile-flutter: job={job_id} task_name={task_name} "
        f"cloning {clone_url} branch={branch}",
        file=sys.stderr,
    )

    tmpdir = tempfile.mkdtemp(prefix="flutter-build-")
    try:
        clone_cmd = ["git", "clone", "--branch", branch]
        if auth_header:
            clone_cmd += ["-c", f"http.extraHeader=Authorization: {auth_header}"]
        clone_cmd += [clone_url, tmpdir]
        clone = subprocess.run(clone_cmd, capture_output=True, text=True)
        if clone.returncode != 0:
            fail(f"git clone failed for branch {branch}: {clone.stderr.strip()}")

        # BUG-09-020 Phase 3: cross-check the cloned tree against the
        # git.file.written event log. If CodeValdGit told us files were
        # written that the clone doesn't have, we're looking at a stale
        # branch head — retry the clone once after a short delay, then
        # fail with infrastructure-error so the merge guard treats this
        # as a pipeline issue rather than a code defect.
        after_iso = task_obj.get("createdAt") if isinstance(task_obj, dict) else ""
        if not after_iso:
            after_iso = (datetime.now(timezone.utc) - timedelta(hours=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
        expected = pubsub_expected_paths(cross_base, agency_id, branch, after_iso, auth_header)
        missing = missing_from_tree(tmpdir, expected) if expected else []
        if missing:
            print(
                f"compile-flutter: clone missing {len(missing)} of {len(expected)} declared file(s); retrying after 2s — first few: {missing[:5]}",
                file=sys.stderr,
            )
            time.sleep(2)
            shutil.rmtree(tmpdir, ignore_errors=True)
            tmpdir = tempfile.mkdtemp(prefix="flutter-build-")
            clone_cmd = ["git", "clone", "--branch", branch]
            if auth_header:
                clone_cmd += ["-c", f"http.extraHeader=Authorization: {auth_header}"]
            clone_cmd += [clone_url, tmpdir]
            retry = subprocess.run(clone_cmd, capture_output=True, text=True)
            if retry.returncode != 0:
                fail(f"git clone retry failed for branch {branch}: {retry.stderr.strip()}")
            missing = missing_from_tree(tmpdir, expected)
            if missing:
                err = (
                    f"branch {branch} is missing {len(missing)} file(s) declared via "
                    f"git.file.written even after retry — possible CodeValdGit flush race"
                )
                print(f"compile-flutter: {err}; missing: {missing}", file=sys.stderr)
                result = json.dumps({
                    "task_id":       task_id,
                    "task_name":     task_name,
                    "branch":        branch,
                    "status":        "infrastructure-error",
                    "missing_files": sorted(missing),
                })
                print(json.dumps({"status": "infrastructure-error", "result": result, "error": err}))
                return

        print(f"compile-flutter: running flutter pub get in {tmpdir}", file=sys.stderr)
        pub_get = subprocess.run(
            ["flutter", "pub", "get"],
            cwd=tmpdir,
            capture_output=True, text=True
        )
        if pub_get.returncode != 0:
            print(f"compile-flutter: flutter pub get failed (non-fatal): {pub_get.stderr.strip()[:200]}", file=sys.stderr)

        print(f"compile-flutter: running flutter analyze in {tmpdir}", file=sys.stderr)
        analyze = subprocess.run(
            ["flutter", "analyze", "--no-fatal-infos", "--no-fatal-warnings"],
            cwd=tmpdir,
            capture_output=True, text=True
        )

        output = (analyze.stdout + analyze.stderr).strip()
        # --no-fatal-infos and --no-fatal-warnings make flutter analyze exit 0
        # when only info-level lints or warnings are present (style suggestions
        # like `use_super_parameters`). The merge guard only blocks for real
        # errors that prevent compilation; style suggestions land in the output
        # for visibility but don't block the merge.
        status = "ok" if analyze.returncode == 0 else "issues-found"

        # Independently verify every relative Dart import resolves. flutter
        # analyze can pass on an incomplete tree (e.g. when the cloned branch
        # is missing files that a later main.dart imports), so this check
        # acts as a backstop on the file tree itself.
        import_issues = check_imports(tmpdir)
        if import_issues:
            status = "issues-found"
            issues_block = "\n".join(import_issues)
            output = f"{output}\n{issues_block}".strip() if output else issues_block

        result = json.dumps({
            "task_id":  task_id,
            "task_name": task_name,
            "branch":   branch,
            "status":   status,
            "output":   output,
        })
        print(json.dumps({"status": status, "result": result}))

    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    main()
