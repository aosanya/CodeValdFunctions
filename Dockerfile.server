# syntax=docker/dockerfile:1
#
# Build context MUST be the monorepo root so the COPY lines can reach
# CodeValdSharedLib/ — go.mod has `replace ... => ../CodeValdSharedLib`,
# which only resolves when SharedLib is present on disk at build time.
#
# Invoked from Deployment/local/docker-compose.yml as:
#   docker compose build codevaldelfunctions

# ── Stage 1: Go build ─────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS gobuild

WORKDIR /src

# SharedLib first — referenced via `replace` in CodeValdFunctions/go.mod.
# Copied to /CodeValdSharedLib so that `../CodeValdSharedLib` resolves from /src.
COPY CodeValdSharedLib/ /CodeValdSharedLib/

# Cache dependency downloads separately from source changes.
COPY CodeValdFunctions/go.mod CodeValdFunctions/go.sum ./
RUN go mod download

# Copy the rest of the source and build the server binary.
COPY CodeValdFunctions/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /codevaldelfunctions-server ./cmd/server

# ── Stage 2: Flutter SDK ──────────────────────────────────────────────────────
FROM debian:bookworm-slim AS fluttersdk

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 -b stable https://github.com/flutter/flutter.git /opt/flutter

ENV PATH="/opt/flutter/bin:${PATH}"
ENV FLUTTER_ROOT="/opt/flutter"

RUN flutter config --no-analytics && \
    flutter precache --no-android --no-ios --no-fuchsia --no-linux --no-macos --no-windows

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fluttersdk /opt/flutter /opt/flutter
COPY --from=gobuild /codevaldelfunctions-server /codevaldelfunctions-server

# Bundled function binaries and manifests (hot-replaceable at runtime via DeployFunction RPC)
COPY CodeValdFunctions/functions/ /opt/functions/
RUN chmod +x /opt/functions/compile-flutter

ENV PATH="/opt/flutter/bin:${PATH}"
ENV FLUTTER_ROOT="/opt/flutter"

# gRPC port — value set by CODEVALDELFUNCTIONS_GRPC_PORT at runtime
EXPOSE 50065

ENTRYPOINT ["/codevaldelfunctions-server"]
